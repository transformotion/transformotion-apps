{
  "name": "@transformotion/infra",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint: infra\"",
    "cdk": "cdk",
    "synth:dev": "cdk synth TransformotionDev-Network",
    "synth:prod": "cdk synth TransformotionProd-Network",
    "deploy:dev": "cdk deploy TransformotionDev-Network --require-approval never",
    "deploy:prod": "cdk deploy TransformotionProd-Network --require-approval never"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.100.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
