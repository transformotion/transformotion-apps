# Launchpad — environment variables
#
# This file is the single source of truth for what environment variables
# the Launchpad app needs to function. It is checked into git and
# is documentation only — it is NOT loaded at runtime.
#
# The Launchpad hosts real sign-in via Cognito Hosted UI and provides
# app-selection tiles for Stock Analyser and Budget Tracker. It uses
# its own dedicated Cognito App Client (LaunchpadAppClient) which
# supports social IDPs (Google, Facebook, Microsoft).
#
# NOTE: deploy-launchpad.yml workflow must pass every [REQUIRED] variable.
#
# Sub-phase 2b of the stabilisation plan adds a CI step that reads this
# file and asserts every [REQUIRED] variable exists as a non-empty GitHub
# Actions environment variable before the build runs.
# See STABILISATION_FREEZE.md → Phase 1 → sub-phase 2.

# ── Tagging convention ────────────────────────────────────────────────────────
# Each variable below is tagged [REQUIRED], [OPTIONAL], or [PLANNED]
# in its preceding comment block:
#
#   [REQUIRED] — the app would behave incorrectly in production if this
#                var is missing. CI sub-phase 2b enforces presence of
#                every [REQUIRED] var in the target GitHub Actions
#                environment before a deploy proceeds.
#
#                A var is [REQUIRED] regardless of whether code has a
#                fallback. Dev-only fallbacks (localhost URLs, debug
#                stubs, mock responses) do NOT make a var optional —
#                they only make local development convenient. The test
#                is: "would the deployed app behave correctly with this
#                var missing?" If no, [REQUIRED].
#
#   [OPTIONAL] — has a sensible production default in code; absence
#                does not break or degrade production behaviour.
#                Examples: feature flags off by default, log levels,
#                poll intervals.
#
#   [PLANNED]  — declared but not yet read by app code. Reserved for
#                upcoming use. Sub-phase 2b skips these.
#
#   [BUILD-INJECTED] — value is injected by the deploy workflow at build
#                time (e.g. commit hash, build timestamp). Not set by
#                humans. Sub-phase 2b does NOT check these — their
#                presence is the deploy workflow's responsibility, not the
#                operator's. Sub-phase 3 verifies they appear in the
#                deployed bundle.
#
# When adding a new variable, choose its tag deliberately and update
# the deploy workflow's env block if [REQUIRED] or [BUILD-INJECTED].
# ─────────────────────────────────────────────────────────────────────────────

# ── Cognito authentication ────────────────────────────────────────────────────

# [REQUIRED]
# AWS Cognito User Pool ID. Shared across all apps.
# Source: CloudFormation output UserPoolId on TransformotionDev-Auth.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX

# [REQUIRED]
# Cognito app client ID for the Launchpad app (LaunchpadAppClient).
# Supports Cognito user pool + social IDPs (Google, Facebook, Microsoft).
# Source: CloudFormation output LaunchpadAppClientId on TransformotionDev-Auth.
# GitHub Actions: mapped from NEXT_PUBLIC_LAUNCHPAD_COGNITO_CLIENT_ID variable.
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-launchpad-cognito-client-id

# [REQUIRED]
# AWS region where Cognito is deployed.
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-2

# [REQUIRED]
# Cognito Hosted UI domain. Used to construct the Hosted UI sign-in URL.
# Source: CloudFormation output CognitoDomain on TransformotionDev-Auth.
NEXT_PUBLIC_COGNITO_DOMAIN=your-cognito-domain.auth.ap-southeast-2.amazoncognito.com

# [REQUIRED]
# Full OAuth callback URL registered in the LaunchpadAppClient.
# Cognito redirects here after authentication.
# Must exactly match the registered callback URL in CDK — no trailing slash.
# For dev:   https://dev.apps.transformotion.com.au/launchpad/callback
# For prod:  https://apps.transformotion.com.au/launchpad/callback
# For local: http://localhost:3001/launchpad/callback
NEXT_PUBLIC_CALLBACK_URL=http://localhost:3001/launchpad/callback

# ── App navigation URLs ───────────────────────────────────────────────────────

# [REQUIRED]
# Public URL of this app (Launchpad). Used to construct NEXT_PUBLIC_SIGNOUT_URL
# and other cross-app redirects. Must be the Launchpad root (no trailing slash).
# For dev:   https://dev.apps.transformotion.com.au
# For prod:  https://apps.transformotion.com.au
# For local: http://localhost:3001
NEXT_PUBLIC_APP_URL=https://dev.apps.transformotion.com.au

# [REQUIRED]
# URL for the signed-out landing page. Cognito's global signOut redirects here
# after clearing the Hosted UI session cookie. Must exactly match the logoutUrls
# entry in CDK (auth-stack.ts). Derived at deploy time from NEXT_PUBLIC_APP_URL.
# For dev:   https://dev.apps.transformotion.com.au/launchpad/signed-out/
# For prod:  https://apps.transformotion.com.au/launchpad/signed-out/
# For local: http://localhost:3001/launchpad/signed-out/
# NEXT_PUBLIC_SIGNOUT_URL=/launchpad/signed-out/

# [REQUIRED]
# URL of the deployed Stock Analyser app. The launchpad's Stock Analyser
# tile navigates here. Falls back to http://localhost:3000 in code for
# local dev convenience only — a deployed launchpad with this var unset
# would point users at localhost and break tile navigation.
# For dev:   https://dev.apps.transformotion.com.au/stock-analyser/
# For prod:  https://apps.transformotion.com.au/stock-analyser/
NEXT_PUBLIC_STOCK_URL=https://dev.apps.transformotion.com.au/stock-analyser/

# [REQUIRED]
# URL of the deployed Budget Tracker app. The launchpad's Budget Tracker
# tile navigates here. Falls back to http://localhost:3002 in code for
# local dev convenience only — a deployed launchpad with this var unset
# would point users at localhost and break tile navigation.
# For dev:   https://dev.apps.transformotion.com.au/budget-tracker/
# For prod:  https://apps.transformotion.com.au/budget-tracker/
NEXT_PUBLIC_BUDGET_URL=https://dev.apps.transformotion.com.au/budget-tracker/

# ── Control-plane API ─────────────────────────────────────────────────────────

# [BUILD-INJECTED]
# Launchpad-owned control-plane API base URL. Extracted from
# Transformotion{Stage}-LaunchpadControlPlane during deploy. This foundation is
# the live owner for POST /auth/lookup-provider after #363 PR 3.
NEXT_PUBLIC_LAUNCHPAD_CONTROL_PLANE_API_URL=

# [OPTIONAL]
# Rollback-only platform AuthApi base URL for auth lookup. The old platform
# route remains deployed during #363, but live Launchpad code should prefer
# NEXT_PUBLIC_LAUNCHPAD_CONTROL_PLANE_API_URL.
# NEXT_PUBLIC_PLATFORM_AUTH_API_URL=

# ── Build-injected ────────────────────────────────────────────────────────────

# ── Runtime profile ───────────────────────────────────────────────────────────

# [REQUIRED]
# Profile for runtime configuration selection (mock | live).
# Determines defaults for auth and data concerns.
# Defaults to 'mock' if unset — safe for local development.
# Set to 'live' in deployed environments via the deploy workflow.
NEXT_PUBLIC_RUNTIME_PROFILE=mock

# [OPTIONAL] Override the auth provider regardless of profile.
# Valid values: mock | cognito
# NEXT_PUBLIC_AUTH_OVERRIDE=cognito

# [OPTIONAL] Override the data provider regardless of profile.
# Valid values: local | dynamo
# NEXT_PUBLIC_DATA_OVERRIDE=local

# ── Build-injected ────────────────────────────────────────────────────────────

# [BUILD-INJECTED]
# The git commit hash that produced this build. Injected by the deploy
# workflow from ${{ github.sha }}. Used by sub-phase 3's deploy-verification
# step to confirm the deployed bundle matches the commit that triggered the
# deploy. Empty in local development (defaults to 'dev' in lib/build-info.ts).
NEXT_PUBLIC_COMMIT_HASH=
